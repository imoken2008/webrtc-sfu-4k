[Unit]
Description=Jetson camera -> SFU hub (H.264 RTP ingest)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=imoken
Environment=SFU_HUB_URL=http://sfu-hub.local:8080
Environment=SFU_ROOM_ID=secretary-cam
Environment=SFU_INGEST_NAME=camlink
Environment="SFU_DISPLAY_NAME=Cam Link 4K"

# Cam Link 4K は 3840x2160@30 の raw のみ。低解像度もMJPEGも選べない。
# 4Kで取り込み、nvvidconv(ハードウェア)で縮小してから送出する。
# ここを4Kのまま送ると、ハブ(Pi 3 / 100Mbps)が視聴者数ぶんを捌けない。
Environment=CAM_DEVICE=/dev/v4l/by-id/usb-Elgato_Cam_Link_4K_0004E6291E000-video-index0
Environment=CAM_WIDTH=3840
Environment=CAM_HEIGHT=2160
Environment=CAM_FPS=30
Environment=CAM_RAW_FORMAT=NV12
Environment=OUT_WIDTH=3840
Environment=OUT_HEIGHT=2160
Environment=CAM_BITRATE=15000000

ExecStart=/home/imoken/stream_to_sfu.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jetson-sfu

[Install]
WantedBy=multi-user.target
