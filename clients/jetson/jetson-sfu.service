[Unit]
Description=Jetson all cameras -> SFU hub (H.264 RTP ingest)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=imoken
Environment=SFU_HUB_URL=http://pi5.local:8080
Environment=SFU_ROOM_ID=secretary-cam

# 接続されている全カメラを自動検出して1台ずつ配信する。
# 抜き差しは SCAN_INTERVAL 秒ごとに検知して起動/停止する。
Environment=STREAMER=/home/imoken/stream_to_sfu.py
Environment=SCAN_INTERVAL=300

# 送出解像度の上限。これを超える入力(Cam Linkの4K等)はVICで縮小する。
Environment=MAX_OUT_WIDTH=1920
Environment=MAX_OUT_HEIGHT=1080
Environment=CAM_FPS=30
Environment=CAM_BITRATE=6000000

ExecStart=/usr/bin/python3 /home/imoken/stream_all_cameras.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jetson-sfu

[Install]
WantedBy=multi-user.target
